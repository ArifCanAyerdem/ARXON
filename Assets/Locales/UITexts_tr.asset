  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2205507543040
    m_Localized: "\u26A1 AR\u0130XON ARENA"
    m_Metadata:
      m_Items: []
  - m_Id: 2205557874688
    m_Localized: '[ ID KARTI ]'
    m_Metadata:
      m_Items: []
  - m_Id: 2205562068992
    m_Localized: "\U0001F3C6 ODA MERKEZ\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 2205562068993
    m_Localized: "Yeni bir saha kurup tak\u0131m\u0131na liderlik et veya koda girip
      ma\xE7a hemen kat\u0131l!"
    m_Metadata:
      m_Items: []
  - m_Id: 2205562068994
    m_Localized: "YEN\u0130 MA\xC7 KUR"
    m_Metadata:
      m_Items: []
  - m_Id: 2205562068995
    m_Localized: 'ODA KODU:'
    m_Metadata:
      m_Items: []
  - m_Id: 2205562068996
    m_Localized: "G\u0130R"
    m_Metadata:
      m_Items: []
  - m_Id: 2205562068997
    m_Localized: "\U0001F4E1 CANLI SAHALAR"
    m_Metadata:
      m_Items: []
  - m_Id: 2205562068998
    m_Localized: "A\u011Fdaki aktif odalar burada anl\u0131k listelenir. Tek t\u0131kla
      odaya kat\u0131labilirsin!"
    m_Metadata:
      m_Items: []
  - m_Id: 2205562068999
    m_Localized: "SAHA \u015EU AN BO\u015E"
    m_Metadata:
      m_Items: []
  - m_Id: 2205562069000
    m_Localized: "Hemen yeni bir ma\xE7 kur ve topu sahaya indir!"
    m_Metadata:
      m_Items: []
  - m_Id: 2205562069001
    m_Localized: "\xC7IKI\u015E"
    m_Metadata:
      m_Items: []
  - m_Id: 2205562069002
    m_Localized: AYARLAR
    m_Metadata:
      m_Items: []
  - m_Id: 2205562069003
    m_Localized: "\U0001F451 LOB\u0130 ODASI"
    m_Metadata:
      m_Items: []
  - m_Id: 2205562069004
    m_Localized: "\U0001F4CB KOPYALA"
    m_Metadata:
      m_Items: []
  - m_Id: 2205562069005
    m_Localized: "\U0001F465 TAKIM \xDCYELER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 2205562069006
    m_Localized: "\U0001F534 KIRMIZI TAKIM"
    m_Metadata:
      m_Items: []
  - m_Id: 2205562069007
    m_Localized: "\U0001F535 MAV\u0130 TAKIM"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263296
    m_Localized: "OYUNCU BEKLEN\u0130YOR..."
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263297
    m_Localized: "\u274C BEKLEN\u0130YOR"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263298
    m_Localized: "\U0001F4AC LOB\u0130 SOHBET\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263299
    m_Localized: "[S\u0130STEM]"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263300
    m_Localized: "Lobiye ho\u015F geldiniz! Ma\xE7 ba\u015Flamadan \xF6nce buradan
      taktik konu\u015Fabilirsiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263301
    m_Localized: "Mesaj\u0131n\u0131 yaz..."
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263302
    m_Localized: "G\xD6NDER \u25B6"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263303
    m_Localized: "\u2B8C ANA SAYFAYA D\xD6N"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263304
    m_Localized: "\U0001F680 OYUNU BA\u015ELAT"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263305
    m_Localized: "GER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263306
    m_Localized: SES
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263307
    m_Localized: "GRAF\u0130K"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263308
    m_Localized: "OYNANI\u015E"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263309
    m_Localized: ANA SES
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263310
    m_Localized: "M\xDCZ\u0130K SES\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263311
    m_Localized: TAM EKRAN
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263312
    m_Localized: "GRAF\u0130K KAL\u0130TES\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263313
    m_Localized: KAMERA SARSINTISI
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263314
    m_Localized: "LANGUAGE (D\u0130L)"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263315
    m_Localized: "Ba\u011Flan\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263316
    m_Localized: "Oda kuruluyor (Host ba\u015Flat\u0131l\u0131yor)..."
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263317
    m_Localized: "L\xFCtfen ge\xE7erli bir oda kodu yaz\u0131n!"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263318
    m_Localized: "HATA: Koduna ait aktif bir oda bulunamad\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263319
    m_Localized: "UYARI: Odadaki ma\xE7 zaten ba\u015Flad\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263320
    m_Localized: 'UYARI: Oda tamamen dolu (4/4)!'
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263321
    m_Localized: "Odas\u0131n\u0131na ba\u011Flan\u0131l\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263322
    m_Localized: "\U0001F451 LOB\u0130 L\u0130DER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263323
    m_Localized: "\U0001F3AE KATILIMCI"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263324
    m_Localized: "\u23F3 L\u0130DER BEKLEN\u0130YOR..."
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263325
    m_Localized: "\U0001F7E2 A\xC7IK"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263326
    m_Localized: "\u2694 MA\xC7TA"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263327
    m_Localized: "\U0001F512 DOLU"
    m_Metadata:
      m_Items: []
  - m_Id: 2205566263328
    m_Localized: "KATIL \u25B6"
    m_Metadata:
      m_Items: []

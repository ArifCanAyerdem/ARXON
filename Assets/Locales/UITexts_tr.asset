  - m_Id: 870284419120
    m_Localized: "KATIL \u25B6"
    m_Metadata:
      m_Items: []
  - m_Id: 7392276144128
    m_Localized: "\u2714 HAZIR"
    m_Metadata:
      m_Items: []
  - m_Id: 7392330670080
    m_Localized: "\u2716 \u0130PTAL (HAZIR)"
    m_Metadata:
      m_Items: []
  - m_Id: 7392330670081
    m_Localized: "\u2714 HAZIR OL"
    m_Metadata:
      m_Items: []
  - m_Id: 7392330670082
    m_Localized: ' (Lider)'
    m_Metadata:
      m_Items: []
  - m_Id: 7392330670083
    m_Localized: ' (Sen)'
    m_Metadata:
      m_Items: []
  - m_Id: 7392330670084
    m_Localized: "Odaya ba\u011Flan\u0131ld\u0131 ({0})! Ho\u015F geldin {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 7392330670085
    m_Localized: "Oyun ba\u015Flat\u0131l\u0131yor! Sahne y\xFCkleniyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 7392330670086
    m_Localized: "\u23F3 OYUNCULAR BEKLEN\u0130YOR..."
    m_Metadata:
      m_Items: []
  - m_Id: 13118675509248
    m_Localized: "D\xFC\u015F\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 13118813921280
    m_Localized: Orta
    m_Metadata:
      m_Items: []
  - m_Id: 13118813921281
    m_Localized: "Y\xFCksek"
    m_Metadata:
      m_Items: []
  - m_Id: 13118813921282
    m_Localized: Ultra
    m_Metadata:
      m_Items: []
  - m_Id: 14653484589056
    m_Localized: "Lider odadan ayr\u0131ld\u0131 veya ba\u011Flant\u0131 koptu."
    m_Metadata:
      m_Items: []
  - m_Id: 14653497171968
    m_Localized: "{0}'in Odas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 14653497171969
    m_Localized: "\U0001F4CB KOPYALA"
    m_Metadata:
      m_Items: []
  - m_Id: 14739434266624
    m_Localized: "\U0001F4E1 Ping: Ba\u011Flan\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 17739401814016
    m_Localized: "\u26A1 AR\u0130XON ARENA"
    m_Metadata:

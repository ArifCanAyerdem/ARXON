<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd">

    <ui:Style src="GameHUD.uss" />

    <ui:VisualElement class="hud-container">
        <!-- Yarı saydam geçiş ekranı (Hata gibi durmaması için lacivert tonlarında) -->
        <ui:VisualElement name="match-overlay" class="overlay-panel">
            <ui:Label text="SAHAYA İNİLİYOR..." name="status-text" class="status-label" />
            <ui:Label text="3" name="countdown-text" class="countdown-text" style="display: none;" />
        </ui:VisualElement>

        <!-- Hologram Timer -->
        <ui:VisualElement class="timer-container">
            <ui:Label text="03:00" name="match-timer" class="match-timer-text" />
        </ui:VisualElement>

        <!-- Kırmızı Takım Skoru (Sağ Üst, Eğik Tasarım) -->
        <ui:VisualElement class="score-panel-red">
            <ui:Label text="0" name="score-red" class="score-text-red" />
        </ui:VisualElement>

        <!-- Mavi Takım Skoru (Sol Üst, Eğik Tasarım) -->
        <ui:VisualElement class="score-panel-blue">
            <ui:Label text="0" name="score-blue" class="score-text-blue" />
        </ui:VisualElement>

        <!-- YATAY GHOST ENERGY BAR -->
        <ui:VisualElement name="boost-container" class="boost-container">
            <ui:Label text="STAMINA" class="boost-label" />
            <Arixon.UI.GhostEnergyBar name="boost-gauge" class="boost-gauge" />
        </ui:VisualElement>

        <!-- Maç Sonu Tablosu -->
        <ui:VisualElement name="leaderboard-panel" class="leaderboard-panel" style="display: none;">
            <ui:Label text="MAÇ BİTTİ!" class="leaderboard-title" />
            <ui:Label text="İstatistikler yakında eklenecektir..." class="leaderboard-text" />
        </ui:VisualElement>

        <!-- TAB Skor Tablosu (Gelişmiş Espor Tasarımı) -->
        <ui:VisualElement name="tab-scoreboard-panel" class="tab-scoreboard-panel" style="display: none;">
            
            <ui:VisualElement class="tab-scoreboard-box">
                <!-- Başlık Satırı (Sütun İsimleri) -->
                <ui:VisualElement class="tab-header-row">
                    <ui:VisualElement class="tab-col-name" />
                    <ui:Label text="Goal" class="tab-col-stat" />
                    <ui:Label text="Assist" class="tab-col-stat" />
                    <ui:Label text="Pass" class="tab-col-stat" />
                    <ui:Label text="Interception" class="tab-col-stat" />
                    <ui:Label text="Save" class="tab-col-stat" />
                    <ui:Label text="Score" class="tab-col-stat" />
                </ui:VisualElement>

                <!-- HOME TEAM (Mavi Takım) -->
                <ui:VisualElement class="tab-team-section home-team">
                    <ui:VisualElement class="tab-team-title-row home-bg">
                        <ui:VisualElement class="team-icon home-icon" />
                        <ui:Label text="HOME" class="team-title-text" />
                    </ui:VisualElement>
                    
                    <ui:ScrollView name="home-team-list" class="tab-player-list" />
                    
                    <ui:VisualElement class="tab-total-row">
                        <ui:Label text="Total match" class="total-text" />
                        <ui:Label text="0" name="home-total-score" class="total-score-text" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- AWAY TEAM (Kırmızı Takım) -->
                <ui:VisualElement class="tab-team-section away-team">
                    <ui:VisualElement class="tab-team-title-row away-bg">
                        <ui:VisualElement class="team-icon away-icon" />
                        <ui:Label text="AWAY" class="team-title-text" />
                    </ui:VisualElement>
                    
                    <ui:ScrollView name="away-team-list" class="tab-player-list" />
                    
                    <ui:VisualElement class="tab-total-row">
                        <ui:Label text="Total match" class="total-text" />
                        <ui:Label text="0" name="away-total-score" class="total-score-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Style src="MainMenu.uss" />

    <!-- Ana Konteyner -->
    <ui:VisualElement name="lobby-root" class="lobby-root">

        <!-- ==================================================================
             EKRAN 1: ANA SAYFA (CARTOON HUB / ODA BULUCU)
             ================================================================== -->
        <ui:VisualElement name="view-home" class="screen-view">
            
            <!-- ÜST HEADER: DİEGETİK STADYUM VİNÇ / ÇATI DİREĞİ -->
            <ui:VisualElement class="diegetic-top-rig">
                
                <ui:VisualElement class="rig-left-plate">
                    <ui:Label name="home-rig-logo" text="⚡ ARİXON ARENA" class="rig-logo" />
                </ui:VisualElement>

                <!-- KULLANICI PROFİL VE İSİM DÜZENLEME (Asılı LED Tabela) -->
                <ui:VisualElement class="rig-center-plate">
                    <ui:Label name="home-id-label" text="[ ID KARTI ]" class="rig-id-label" />
                    <ui:TextField name="input-player-name" class="rig-input-name" value="Oyuncu_01" max-length="16" />
                </ui:VisualElement>

                <ui:VisualElement class="rig-right-plate">
                    <ui:VisualElement class="ping-dot" />
                    <ui:Label text="TR-IST (14ms)" class="server-info" />
                </ui:VisualElement>
                
            </ui:VisualElement>

            <!-- ORTA ALAN: SOCCER ARCADE HUB -->
            <ui:VisualElement class="home-section">

                <!-- MERKEZİ SOCCER KUTUSU -->
                <ui:VisualElement class="soccer-hub-container">
                    
                    <!-- SOL PANEL: ODA YÖNETİMİ -->
                    <ui:VisualElement class="home-left-panel">
                        <ui:VisualElement class="soccer-badge badge-orange">
                            <ui:Label name="home-badge-room-center" text="🏆 ODA MERKEZİ" class="soccer-badge-title" />
                        </ui:VisualElement>

                        <ui:Label name="home-desc-create" text="Yeni bir saha kurup takımına liderlik et veya koda girip maça hemen katıl!" class="soccer-desc-text" />

                        <!-- ODA KUR BUTONU -->
                        <ui:Button text="YENİ MAÇ KUR" name="btn-home-create-room" class="btn-soccer btn-soccer-primary" />

                        <ui:VisualElement class="soccer-divider" />

                        <!-- KODLA KATILMA KUTUSU -->
                        <ui:VisualElement class="soccer-code-box">
                            <ui:Label name="home-room-code-lbl" text="ODA KODU:" class="soccer-input-label" />
                            <ui:VisualElement class="code-input-row">
                                <ui:TextField name="input-room-code" class="soccer-input-field" placeholder-text="#ARX-..." />
                                <ui:Button text="GİR" name="btn-home-join-code" class="btn-soccer btn-soccer-green btn-small" />
                            </ui:VisualElement>
                            <ui:Label text="" name="home-status-msg" class="status-log-home" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- SAĞ PANEL: AKTİF LOBİ LİSTESİ -->
                    <ui:VisualElement class="home-right-panel">
                        <ui:VisualElement class="soccer-badge badge-blue">
                            <ui:Label name="home-badge-live-fields" text="📡 CANLI SAHALAR" class="soccer-badge-title" />
                        </ui:VisualElement>
                    
                    <ui:Label name="home-desc-live" text="Ağdaki aktif odalar burada anlık listelenir. Tek tıkla odaya katılabilirsin!" class="home-card-desc" />

                        <!-- CANLI ODA LİSTESİ -->
                        <ui:ScrollView name="rooms-scroll" class="rooms-scroll">
                            <ui:VisualElement name="empty-rooms-box" class="soccer-empty-box">
                                <ui:Label text="⚽" class="soccer-empty-icon" />
                                <ui:Label name="home-empty-title" text="SAHA ŞU AN BOŞ" class="soccer-empty-title" />
                                <ui:Label name="home-empty-desc" text="Hemen yeni bir maç kur ve topu sahaya indir!" class="soccer-empty-desc" />
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ALT BAR -->
            <ui:VisualElement class="footer-bar">
                <ui:VisualElement class="footer-left-buttons">
                    <ui:Button text="ÇIKIŞ" name="btn-home-quit" class="btn-soccer btn-soccer-red btn-small" />
                    <ui:Button text="AYARLAR" name="btn-home-settings" class="btn-soccer btn-soccer-purple btn-small" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>


        <!-- ==================================================================
             EKRAN 2: LOBİ ODASI (CARTOON LOBBY ROOM VE SOHBET)
             ================================================================== -->
        <ui:VisualElement name="view-lobby" class="screen-view" style="display: none;">

            <!-- ÜST BİLGİ VE BAŞLIK ÇUBUĞU (HEADER) -->
            <ui:VisualElement class="header-bar">
                <ui:VisualElement class="header-left">
                    <ui:Label name="lobby-logo-lbl" text="⚡ ARİXON" class="lobby-logo" />
                    <ui:Label text="👑 LOBİ ODASI" name="lobby-badge" class="lobby-badge" />
                </ui:VisualElement>

                <ui:VisualElement class="header-center room-code-pill">
                    <ui:Label text="ODA KODU:" class="room-code-label" />
                    <ui:Label text="#ARX-0000" name="room-code-val" class="room-code-val" />
                    <ui:Button text="📋 KOPYALA" name="btn-copy-code" class="btn-cartoon btn-cartoon-cyan btn-copy-small" />
                </ui:VisualElement>

                <ui:VisualElement class="header-right">
                    <ui:VisualElement class="ping-dot" />
                    <ui:Label name="ping-label" text="📡 Ping: Bağlanıyor..." class="server-info" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ORTA ALAN: OYUNCU SLOTLARI + SAĞ ODA AYARLARI VE SOHBET -->
            <ui:VisualElement class="main-section">

                <!-- SOL / ORTA: 4 Kişilik Takım Oyuncu Slotları -->
                <ui:VisualElement class="roster-panel cartoon-panel">
                    <ui:VisualElement class="panel-header-badge yellow-badge">
                        <ui:Label text="👥 TAKIM ÜYELERİ (1/4)" name="roster-title" class="badge-title" />
                    </ui:VisualElement>

                    <ui:VisualElement class="teams-wrapper">
                        
                        <!-- KIRMIZI TAKIM -->
                        <ui:VisualElement class="team-column">
                            <ui:VisualElement class="team-badge-red">
                                <ui:Label text="🔴 KIRMIZI TAKIM" style="color: white; -unity-font-style: bold; font-size: 14px;" />
                            </ui:VisualElement>

                            <!-- SLOT 1 -->
                            <ui:VisualElement name="slot-1-card" class="player-card empty-card" style="width: 100%;">
                                <ui:VisualElement name="slot-1-crown" class="card-crown-tag" style="display: none;">
                                    <ui:Label text="👑 LİDER" class="crown-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="slot-1-circle" class="empty-avatar-circle">
                                    <ui:Label text="+" name="slot-1-avatar-tag" class="empty-plus" />
                                </ui:VisualElement>
                                <ui:Label text="OYUNCU BEKLENİYOR..." name="slot-1-name" class="empty-title" />
                                <ui:VisualElement name="slot-1-ready" class="ready-pill" style="display: none; background-color: rgb(150, 40, 30);">
                                    <ui:Label text="❌ BEKLENİYOR" name="slot-1-ready-lbl" class="ready-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- SLOT 2 -->
                            <ui:VisualElement name="slot-2-card" class="player-card empty-card" style="width: 100%;">
                                <ui:VisualElement name="slot-2-crown" class="card-crown-tag" style="display: none;">
                                    <ui:Label text="👑 LİDER" class="crown-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="slot-2-circle" class="empty-avatar-circle">
                                    <ui:Label text="+" name="slot-2-avatar-tag" class="empty-plus" />
                                </ui:VisualElement>
                                <ui:Label text="OYUNCU BEKLENİYOR..." name="slot-2-name" class="empty-title" />
                                <ui:VisualElement name="slot-2-ready" class="ready-pill" style="display: none; background-color: rgb(150, 40, 30);">
                                    <ui:Label text="❌ BEKLENİYOR" name="slot-2-ready-lbl" class="ready-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- MAVI TAKIM -->
                        <ui:VisualElement class="team-column">
                            <ui:VisualElement class="team-badge-blue">
                                <ui:Label text="🔵 MAVİ TAKIM" style="color: white; -unity-font-style: bold; font-size: 14px;" />
                            </ui:VisualElement>

                            <!-- SLOT 3 -->
                            <ui:VisualElement name="slot-3-card" class="player-card empty-card" style="width: 100%;">
                                <ui:VisualElement name="slot-3-crown" class="card-crown-tag" style="display: none;">
                                    <ui:Label text="👑 LİDER" class="crown-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="slot-3-circle" class="empty-avatar-circle">
                                    <ui:Label text="+" name="slot-3-avatar-tag" class="empty-plus" />
                                </ui:VisualElement>
                                <ui:Label text="OYUNCU BEKLENİYOR..." name="slot-3-name" class="empty-title" />
                                <ui:VisualElement name="slot-3-ready" class="ready-pill" style="display: none; background-color: rgb(150, 40, 30);">
                                    <ui:Label text="❌ BEKLENİYOR" name="slot-3-ready-lbl" class="ready-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- SLOT 4 -->
                            <ui:VisualElement name="slot-4-card" class="player-card empty-card" style="width: 100%;">
                                <ui:VisualElement name="slot-4-crown" class="card-crown-tag" style="display: none;">
                                    <ui:Label text="👑 LİDER" class="crown-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="slot-4-circle" class="empty-avatar-circle">
                                    <ui:Label text="+" name="slot-4-avatar-tag" class="empty-plus" />
                                </ui:VisualElement>
                                <ui:Label text="OYUNCU BEKLENİYOR..." name="slot-4-name" class="empty-title" />
                                <ui:VisualElement name="slot-4-ready" class="ready-pill" style="display: none; background-color: rgb(150, 40, 30);">
                                    <ui:Label text="❌ BEKLENİYOR" name="slot-4-ready-lbl" class="ready-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- SAĞ ALAN: AYARLAR VE CANLI LOBİ SOHBETİ -->
                <ui:VisualElement class="side-panel">
                    
                    <!-- Canlı Lobi Sohbet Kutusu -->
                    <ui:VisualElement class="cartoon-panel chat-panel-box">
                        <ui:VisualElement class="panel-header-badge pink-badge">
                            <ui:Label text="💬 LOBİ SOHBETİ" class="badge-title" />
                        </ui:VisualElement>

                        <!-- Mesaj Akışı -->
                        <ui:ScrollView name="chat-scroll" class="chat-scroll">
                        </ui:ScrollView>

                        <!-- Mesaj Gönderme Giriş Alanı -->
                        <ui:VisualElement class="chat-input-row">
                            <ui:TextField name="chat-input" class="chat-input" placeholder-text="Mesajını yaz..." />
                            <ui:Button text="GÖNDER ▶" name="btn-chat-send" class="btn-soccer btn-soccer-green" style="font-size: 14px; padding: 4px 12px; height: 40px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

            <!-- ALT AKSİYON ÇUBUĞU (FOOTER) -->
            <ui:VisualElement class="footer-bar" style="justify-content: space-between; width: 100%; padding-top: 20px;">
                <ui:VisualElement class="footer-left-buttons">
                    <ui:Button text="⮌ ANA SAYFAYA DÖN" name="btn-leave-lobby" class="btn-soccer btn-soccer-red" />
                </ui:VisualElement>

                <ui:VisualElement class="footer-right-buttons" style="flex-direction: row; align-items: center;">
                    <ui:Button text="🚀 OYUNU BAŞLAT" name="btn-start-game" class="btn-soccer btn-soccer-green" style="font-size: 24px; padding: 15px 40px; height: 60px;" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ==================================================================
             EKRAN 3: AYARLAR (SETTINGS MENU)
             ================================================================== -->
        <ui:VisualElement name="view-settings" class="settings-fullscreen-overlay" style="display: none;">
            
            <!-- Üst Bar: Başlık, Geri Butonu ve Sekmeler -->
            <ui:VisualElement class="settings-top-bar">
                
                <ui:VisualElement class="settings-top-left">
                    <ui:Label text="SETTINGS" class="settings-main-title" />
                    <ui:Button text="BACK" name="btn-close-settings" class="settings-btn-back" />
                </ui:VisualElement>

                <ui:VisualElement class="settings-tabs-container">
                    <ui:Button text="AUDIO" name="btn-tab-audio" class="settings-tab active-tab" />
                    <ui:Button text="GRAPHICS" name="btn-tab-graphics" class="settings-tab" />
                    <ui:Button text="GAMEPLAY" name="btn-tab-gameplay" class="settings-tab" />
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- İçerik Alanı -->
            <ui:VisualElement class="settings-content-wrapper">
                <ui:ScrollView class="settings-list-scroll">

                    <!-- AUDIO SECTION -->
                    <ui:VisualElement name="content-audio" style="display: flex;">
                        <ui:VisualElement class="settings-row-strip row-dark">
                            <ui:Label text="MASTER VOLUME" class="settings-row-label" />
                            <ui:Slider name="slider-master-volume" low-value="0" high-value="100" value="100" class="modern-slider" />
                        </ui:VisualElement>

                        <ui:VisualElement class="settings-row-strip row-light">
                            <ui:Label text="MUSIC VOLUME" class="settings-row-label" />
                            <ui:Slider name="slider-music-volume" low-value="0" high-value="100" value="80" class="modern-slider" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- GRAPHICS SECTION -->
                    <ui:VisualElement name="content-graphics" style="display: none;">
                        <ui:VisualElement class="settings-row-strip row-dark">
                            <ui:Label text="FULLSCREEN" class="settings-row-label" />
                            <ui:Toggle name="toggle-fullscreen" value="true" class="modern-toggle" />
                        </ui:VisualElement>

                        <ui:VisualElement class="settings-row-strip row-light">
                            <ui:Label text="GRAPHICS QUALITY" class="settings-row-label" />
                            <ui:DropdownField name="dropdown-quality" choices="Low,Medium,High,Ultra" index="2" class="modern-dropdown" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- GAMEPLAY SECTION -->
                    <ui:VisualElement name="content-gameplay" style="display: none;">
                        <ui:VisualElement class="settings-row-strip row-dark">
                            <ui:Label text="LANGUAGE (DİL)" class="settings-row-label" />
                            <ui:DropdownField name="dropdown-language" choices="English,Türkçe" index="0" class="modern-dropdown" />
                        </ui:VisualElement>

                        <ui:VisualElement class="settings-row-strip row-light">
                            <ui:Label text="CAMERA SHAKE" class="settings-row-label" />
                            <ui:Toggle name="toggle-camera-shake" value="true" class="modern-toggle" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:ScrollView>
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>

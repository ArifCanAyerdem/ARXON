<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Style src="MainMenu.uss" />

    <!-- Ana Konteyner -->
    <ui:VisualElement name="lobby-root" class="lobby-root">

        <!-- ==================================================================
             EKRAN 1: ANA SAYFA (CARTOON HUB / ODA BULUCU)
             ================================================================== -->
        <ui:VisualElement name="view-home" class="screen-view">
            
            <!-- ÜST HEADER -->
            <ui:VisualElement class="header-bar">
                <ui:VisualElement class="header-left">
                    <ui:Label text="⚡ ARİXON" class="lobby-logo" />
                    <ui:Label text="BETA • OYUN MERKEZİ" class="lobby-badge" />
                </ui:VisualElement>

                <!-- KULLANICI PROFİL VE İSİM DÜZENLEME -->
                <ui:VisualElement class="header-center profile-box">
                    <ui:Label text="👤 OYUNCU ADIN:" class="profile-label" />
                    <ui:TextField name="input-player-name" class="input-player-name" value="Oyuncu_01" max-length="16" />
                </ui:VisualElement>

                <ui:VisualElement class="header-right">
                    <ui:VisualElement class="ping-dot" />
                    <ui:Label text="TR-ISTANBUL (14ms)" class="server-info" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ORTA ALAN: SOL (ODA KUR/KOD GİR) + SAĞ (AÇIK/KAPALI ODALAR LİSTESİ) -->
            <ui:VisualElement class="home-section">

                <!-- SOL PANEL: ODA YÖNETİMİ -->
                <ui:VisualElement class="home-left-panel cartoon-panel">
                    <ui:VisualElement class="panel-header-badge orange-badge">
                        <ui:Label text="🎮 ODA MERKEZİ" class="badge-title" />
                    </ui:VisualElement>

                    <ui:Label text="Yeni bir oda kurup arkadaşlarına liderlik et veya paylaşılan kodu yazıp hemen savaşa katıl!" class="home-card-desc" />

                    <!-- ODA KUR BUTONU -->
                    <ui:Button text="👑 + YENİ ODA KUR" name="btn-home-create-room" class="btn-cartoon btn-cartoon-orange" />

                    <ui:VisualElement class="divider-line" />

                    <!-- KODLA KATILMA KUTUSU -->
                    <ui:VisualElement class="code-entry-box">
                        <ui:Label text="🔑 ODA KODU İLE KATIL:" class="info-label-cartoon" />
                        <ui:VisualElement class="code-input-row">
                            <ui:TextField name="input-room-code" class="input-code-field" placeholder-text="#ARX-..." />
                            <ui:Button text="GİR ▶" name="btn-home-join-code" class="btn-cartoon btn-cartoon-green btn-small-enter" />
                        </ui:VisualElement>
                        <ui:Label text="" name="home-status-msg" class="status-log-home" />
                    </ui:VisualElement>


                </ui:VisualElement>

                <!-- SAĞ PANEL: AKTİF LOBİ VE SUNUCU LİSTESİ -->
                <ui:VisualElement class="home-right-panel cartoon-panel">
                    <ui:VisualElement class="panel-header-badge blue-badge">
                        <ui:Label text="📡 CANLI ODALAR VE SUNUCULAR" class="badge-title" />
                    </ui:VisualElement>
                    
                    <ui:Label text="Ağdaki aktif odalar burada anlık listelenir. Tek tıkla odaya katılabilirsin!" class="home-card-desc" />

                    <!-- CANLI ODA LİSTESİ (C# TARAFINDAN DİNAMİK DOLDURULUR) -->
                    <ui:ScrollView name="rooms-scroll" class="rooms-scroll">
                        <ui:VisualElement name="empty-rooms-box" class="empty-rooms-box">
                            <ui:Label text="🏝️" class="empty-rooms-icon" />
                            <ui:Label text="ŞU ANDA AÇIK ODA YOK!" class="empty-rooms-title" />
                            <ui:Label text="Henüz kimse oda kurmadı. Sol taraftaki 'YENİ ODA KUR' butonuna basarak ilk odayı sen açabilirsin!" class="empty-rooms-desc" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- ALT BAR -->
            <ui:VisualElement class="footer-bar">
                <ui:VisualElement class="footer-left-buttons">
                    <ui:Button text="⮌ OYUNDAN ÇIK" name="btn-home-quit" class="btn-cartoon btn-cartoon-red" />
                    <ui:Button text="⚙ AYARLAR" name="btn-home-settings" class="btn-cartoon btn-cartoon-purple" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>


        <!-- ==================================================================
             EKRAN 2: LOBİ ODASI (CARTOON LOBBY ROOM VE SOHBET)
             ================================================================== -->
        <ui:VisualElement name="view-lobby" class="screen-view" style="display: none;">

            <!-- ÜST BİLGİ VE BAŞLIK ÇUBUĞU (HEADER) -->
            <ui:VisualElement class="header-bar">
                <ui:VisualElement class="header-left">
                    <ui:Label text="⚡ ARİXON" class="lobby-logo" />
                    <ui:Label text="👑 LOBİ ODASI" name="lobby-badge" class="lobby-badge" />
                </ui:VisualElement>

                <ui:VisualElement class="header-center room-code-pill">
                    <ui:Label text="ODA KODU:" class="room-code-label" />
                    <ui:Label text="#ARX-0000" name="room-code-val" class="room-code-val" />
                    <ui:Button text="📋 KOPYALA" name="btn-copy-code" class="btn-cartoon btn-cartoon-cyan btn-copy-small" />
                </ui:VisualElement>

                <ui:VisualElement class="header-right">
                    <ui:VisualElement class="ping-dot" />
                    <ui:Label name="ping-label" text="📡 Ping: Bağlanıyor..." class="server-info" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ORTA ALAN: OYUNCU SLOTLARI + SAĞ ODA AYARLARI VE SOHBET -->
            <ui:VisualElement class="main-section">

                <!-- SOL / ORTA: 4 Kişilik Takım Oyuncu Slotları -->
                <ui:VisualElement class="roster-panel cartoon-panel">
                    <ui:VisualElement class="panel-header-badge yellow-badge">
                        <ui:Label text="👥 TAKIM ÜYELERİ (1/4)" name="roster-title" class="badge-title" />
                    </ui:VisualElement>

                    <ui:VisualElement class="teams-wrapper">
                        
                        <!-- KIRMIZI TAKIM -->
                        <ui:VisualElement class="team-column">
                            <ui:VisualElement class="team-badge-red">
                                <ui:Label text="🔴 KIRMIZI TAKIM" style="color: white; -unity-font-style: bold; font-size: 14px;" />
                            </ui:VisualElement>

                            <!-- SLOT 1 -->
                            <ui:VisualElement name="slot-1-card" class="player-card empty-card" style="width: 100%;">
                                <ui:VisualElement name="slot-1-crown" class="card-crown-tag" style="display: none;">
                                    <ui:Label text="👑 LİDER" class="crown-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="slot-1-circle" class="empty-avatar-circle">
                                    <ui:Label text="+" name="slot-1-avatar-tag" class="empty-plus" />
                                </ui:VisualElement>
                                <ui:Label text="OYUNCU BEKLENİYOR..." name="slot-1-name" class="empty-title" />
                                <ui:VisualElement name="slot-1-ready" class="ready-pill" style="display: none; background-color: rgb(150, 40, 30);">
                                    <ui:Label text="❌ BEKLENİYOR" name="slot-1-ready-lbl" class="ready-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- SLOT 2 -->
                            <ui:VisualElement name="slot-2-card" class="player-card empty-card" style="width: 100%;">
                                <ui:VisualElement name="slot-2-crown" class="card-crown-tag" style="display: none;">
                                    <ui:Label text="👑 LİDER" class="crown-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="slot-2-circle" class="empty-avatar-circle">
                                    <ui:Label text="+" name="slot-2-avatar-tag" class="empty-plus" />
                                </ui:VisualElement>
                                <ui:Label text="OYUNCU BEKLENİYOR..." name="slot-2-name" class="empty-title" />
                                <ui:VisualElement name="slot-2-ready" class="ready-pill" style="display: none; background-color: rgb(150, 40, 30);">
                                    <ui:Label text="❌ BEKLENİYOR" name="slot-2-ready-lbl" class="ready-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- MAVI TAKIM -->
                        <ui:VisualElement class="team-column">
                            <ui:VisualElement class="team-badge-blue">
                                <ui:Label text="🔵 MAVİ TAKIM" style="color: white; -unity-font-style: bold; font-size: 14px;" />
                            </ui:VisualElement>

                            <!-- SLOT 3 -->
                            <ui:VisualElement name="slot-3-card" class="player-card empty-card" style="width: 100%;">
                                <ui:VisualElement name="slot-3-crown" class="card-crown-tag" style="display: none;">
                                    <ui:Label text="👑 LİDER" class="crown-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="slot-3-circle" class="empty-avatar-circle">
                                    <ui:Label text="+" name="slot-3-avatar-tag" class="empty-plus" />
                                </ui:VisualElement>
                                <ui:Label text="OYUNCU BEKLENİYOR..." name="slot-3-name" class="empty-title" />
                                <ui:VisualElement name="slot-3-ready" class="ready-pill" style="display: none; background-color: rgb(150, 40, 30);">
                                    <ui:Label text="❌ BEKLENİYOR" name="slot-3-ready-lbl" class="ready-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- SLOT 4 -->
                            <ui:VisualElement name="slot-4-card" class="player-card empty-card" style="width: 100%;">
                                <ui:VisualElement name="slot-4-crown" class="card-crown-tag" style="display: none;">
                                    <ui:Label text="👑 LİDER" class="crown-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="slot-4-circle" class="empty-avatar-circle">
                                    <ui:Label text="+" name="slot-4-avatar-tag" class="empty-plus" />
                                </ui:VisualElement>
                                <ui:Label text="OYUNCU BEKLENİYOR..." name="slot-4-name" class="empty-title" />
                                <ui:VisualElement name="slot-4-ready" class="ready-pill" style="display: none; background-color: rgb(150, 40, 30);">
                                    <ui:Label text="❌ BEKLENİYOR" name="slot-4-ready-lbl" class="ready-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- SAĞ ALAN: AYARLAR VE CANLI LOBİ SOHBETİ -->
                <ui:VisualElement class="side-panel">
                    
                    <!-- Canlı Lobi Sohbet Kutusu -->
                    <ui:VisualElement class="cartoon-panel chat-panel-box">
                        <ui:VisualElement class="panel-header-badge pink-badge">
                            <ui:Label text="💬 LOBİ SOHBETİ" class="badge-title" />
                        </ui:VisualElement>

                        <!-- Mesaj Akışı -->
                        <ui:ScrollView name="chat-scroll" class="chat-scroll">
                            <ui:VisualElement class="chat-entry system-entry">
                                <ui:Label text="[SİSTEM]" class="sender-system" />
                                <ui:Label text="Lobiye hoş geldiniz! Maç başlamadan önce buradan taktik konuşabilirsiniz." class="msg-text-system" />
                            </ui:VisualElement>
                        </ui:ScrollView>

                        <!-- Mesaj Gönderme Giriş Alanı -->
                        <ui:VisualElement class="chat-input-row">
                            <ui:TextField name="chat-input" class="chat-input" placeholder-text="Mesajını yaz..." />
                            <ui:Button text="GÖNDER ▶" name="btn-chat-send" class="btn-cartoon btn-cartoon-green btn-chat-small" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

            <!-- ALT AKSİYON ÇUBUĞU (FOOTER) -->
            <ui:VisualElement class="footer-bar">
                <ui:VisualElement class="footer-left-buttons">
                    <ui:Button text="⮌ ANA SAYFAYA DÖN" name="btn-leave-lobby" class="btn-cartoon btn-cartoon-red" />
                </ui:VisualElement>

                <ui:VisualElement class="footer-right-buttons" style="flex-direction: row; align-items: center;">
                    <ui:Button text="🚀 OYUNU BAŞLAT" name="btn-start-game" class="btn-cartoon btn-cartoon-green btn-large-start" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>

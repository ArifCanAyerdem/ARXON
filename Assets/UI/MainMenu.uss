/* ==========================================================================
   ARÄ°XON - CARTOON / STYLIZED OYUN ARAYÃœZÃœ (CARTOON UI TOOLKIT STYLES)
   Tema: Enerjik, CanlÄ±, 3D BasÄ±labilir Ã‡izgi Film ButonlarÄ± & Tombul Kartlar
   Renkler: CanlÄ± Turuncu, AltÄ±n SarÄ±sÄ±, FÄ±stÄ±k YeÅŸili, GÃ¶kyÃ¼zÃ¼ Mavisi, Derin Mor
   ========================================================================== */

/* Tam Ekran Arka Plan */
.lobby-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 20, 35); /* Koyu stadyum laciverti */
    background-image: none; /* AI resimleri kaldÄ±rÄ±ldÄ±, temiz arka plan */
    justify-content: center; /* Merkezi kutuyu ortala */
    align-items: center;
    padding: 20px 30px;
}

.screen-view {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
}

/* --------------------------------------------------------------------------
   ÃœST HEADER: DÄ°EGETÄ°K STADYUM VÄ°NÃ‡ / Ã‡ATI DÄ°REÄÄ°
   -------------------------------------------------------------------------- */
.diegetic-top-rig {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    background-color: rgb(25, 28, 35); /* Koyu Demir */
    border-bottom-width: 8px;
    border-bottom-color: rgb(15, 18, 22); /* Demir Alt GÃ¶lgesi */
    padding: 0 40px;
    height: 80px;
    box-shadow: 0px 10px 20px rgba(0,0,0,0.5); /* Derinlik */
}

/* Sol Tabela (Logo) */
.rig-left-plate {
    background-color: rgb(40, 45, 55);
    border-width: 4px;
    border-top-width: 0; /* DireÄŸe asÄ±lÄ± gibi */
    border-color: rgb(80, 90, 100);
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    padding: 10px 24px;
    margin-right: 20px;
}

.rig-logo {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(241, 196, 15);
    letter-spacing: 2px;
    text-shadow: 2px 3px 0px rgba(0,0,0,0.5);
}

/* Orta Tabela (KullanÄ±cÄ± AdÄ±) */
.rig-center-plate {
    flex-direction: row;
    align-items: center;
    background-color: rgb(15, 18, 22); /* Koyu Ekran */
    border-width: 4px;
    border-top-width: 0;
    border-color: rgb(60, 70, 80);
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    padding: 8px 24px;
}

.rig-id-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(180, 190, 200);
    margin-right: 12px;
    letter-spacing: 2px;
}

.rig-input-name {
    width: 200px;
    height: 40px;
    background-color: transparent;
}

.rig-input-name .unity-text-field__input {
    color: rgb(0, 255, 150); /* Neon yeÅŸil yazÄ± */
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding: 4px 12px;
    background-color: rgb(10, 12, 15);
    border-width: 2px;
    border-color: rgb(100, 110, 120);
    border-radius: 6px;
    -unity-text-align: middle-center;
}

.rig-input-name:focus {
    border-color: rgb(241, 196, 15);
}

/* SaÄŸ Tabela (Sunucu Bilgisi) */
.rig-right-plate {
    flex-direction: row;
    align-items: center;
    background-color: rgb(40, 45, 55);
    border-width: 4px;
    border-top-width: 0;
    border-color: rgb(80, 90, 100);
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    padding: 10px 24px;
}

.ping-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(46, 204, 113);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    margin-right: 12px;
    box-shadow: 0px 0px 8px rgb(46, 204, 113); /* Neon parlama */
}

.server-info {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(200, 210, 220);
    letter-spacing: 1px;
}

/* --------------------------------------------------------------------------
   GENEL CARTOON PANELLER & KARTLAR
   -------------------------------------------------------------------------- */
.cartoon-panel {
    background-color: rgba(34, 25, 61, 0.85);
    border-width: 3px;
    border-color: rgb(88, 173, 255);
    border-bottom-width: 7px;
    border-bottom-color: rgb(15, 10, 28);
    border-radius: 20px;
    padding: 20px;
}

.panel-header-badge {
    align-self: flex-start;
    border-radius: 12px;
    padding: 5px 14px;
    margin-bottom: 12px;
    border-width: 2px;
}

.orange-badge {
    background-color: rgb(255, 120, 0);
    border-color: rgb(255, 175, 70);
}

.blue-badge {
    background-color: rgb(0, 168, 255);
    border-color: rgb(100, 210, 255);
}

.yellow-badge {
    background-color: rgb(255, 195, 18);
    border-color: rgb(255, 230, 110);
}

.pink-badge {
    background-color: rgb(232, 67, 147);
    border-color: rgb(255, 125, 185);
}

.badge-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
}

.yellow-badge > .badge-title {
    color: rgb(30, 30, 30);
}

.home-card-desc {
    font-size: 13px;
    color: rgb(170, 155, 210);
    margin-bottom: 16px;
    white-space: normal;
}

/* --------------------------------------------------------------------------
   SOCCER ARCADE MERKEZÄ° HUB TASARIMI
   -------------------------------------------------------------------------- */
.home-section {
    width: 85%;
    height: 75%;
    flex-direction: row;
    margin-bottom: 20px;
}

.soccer-hub-container {
    flex-grow: 1;
    flex-direction: row;
    background-color: rgba(20, 25, 45, 0.95); /* Koyu lacivert stadyum gecesi */
    border-radius: 12px;
    border-width: 4px;
    border-color: rgb(46, 204, 113); /* CanlÄ± Ã§im yeÅŸili kenarlÄ±k */
    border-bottom-width: 10px;
    border-bottom-color: rgb(20, 100, 50);
    padding: 30px;
    box-shadow: 0px 15px 30px rgba(0,0,0,0.6);
}

.home-left-panel {
    width: 45%;
    margin-right: 40px;
    justify-content: space-between;
}

.home-right-panel {
    flex-grow: 1;
    width: 50%;
}

.soccer-badge {
    align-self: flex-start;
    border-radius: 6px;
    padding: 6px 16px;
    margin-bottom: 12px;
    border-width: 2px;
}

.badge-orange { background-color: rgb(230, 126, 34); border-color: rgb(243, 156, 18); }
.badge-blue { background-color: rgb(52, 152, 219); border-color: rgb(41, 128, 185); }

.soccer-badge-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 2px;
}

.soccer-desc-text {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(180, 200, 220);
    margin-bottom: 20px;
    white-space: normal;
}

.soccer-divider {
    height: 4px;
    background-color: rgb(46, 204, 113);
    border-radius: 2px;
    margin: 20px 0;
}

/* Kod GiriÅŸ AlanÄ± */
.soccer-code-box {
    background-color: rgb(15, 20, 45);
    border-width: 2px;
    border-color: rgb(40, 60, 100);
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 12px;
}

.soccer-input-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(241, 196, 15); /* Hakem sarÄ±sÄ± */
    margin-bottom: 6px;
}

.code-input-row {
    flex-direction: row;
    align-items: center;
}

.soccer-input-field {
    flex-grow: 1;
    height: 48px;
    background-color: rgb(255, 255, 255);
    border-width: 3px;
    border-color: rgb(189, 195, 199);
    border-radius: 6px;
    margin-right: 12px;
}

.soccer-input-field .unity-text-field__input {
    color: rgb(44, 62, 80);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    padding: 6px 16px;
    background-color: transparent;
    -unity-text-align: middle-left;
}

.soccer-input-field:focus {
    border-color: rgb(46, 204, 113);
}

.status-log-home {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 140, 140);
    margin-top: 6px;
    white-space: normal;
}

/* --------------------------------------------------------------------------
   CANLI ODA LÄ°STESÄ° (ROOMS SCROLLVIEW) & ODA KARTLARI
   -------------------------------------------------------------------------- */
.rooms-scroll {
    flex-grow: 1;
    margin-top: 8px;
}

/* BoÅŸ Liste Kutusu */
.soccer-empty-box {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    background-color: rgb(20, 30, 50);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(40, 60, 90);
    border-style: dashed;
}

.soccer-empty-icon {
    font-size: 72px;
    margin-bottom: 16px;
}

.soccer-empty-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(236, 240, 241);
    margin-bottom: 8px;
}

.soccer-empty-desc {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(149, 165, 166);
    text-align: center;
    white-space: normal;
    max-width: 380px;
}

/* Dinamik Ãœretilen Arcade Oda KartÄ± (EKSÄ°K OLAN KISIM BURASIYDI) */
.room-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgb(30, 35, 60);
    border-width: 3px;
    border-color: rgb(60, 80, 120);
    border-bottom-width: 6px;
    border-bottom-color: rgb(15, 20, 35);
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 12px;
}

.room-open {
    border-color: rgb(46, 204, 113);
}

.room-closed {
    border-color: rgb(231, 76, 60);
    opacity: 0.7;
}

.room-item-left {
    flex-direction: row;
    align-items: center;
}

.room-badge-status {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-right: 16px;
}

.badge-open { background-color: rgb(46, 204, 113); }
.badge-closed { background-color: rgb(231, 76, 60); }

.room-item-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-right: 16px;
}

.room-item-code {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(241, 196, 15);
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 1px;
    border-color: rgb(241, 196, 15);
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 1px;
}

.room-item-right {
    flex-direction: row;
    align-items: center;
}

.room-item-players {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(100, 220, 255);
    margin-right: 20px;
}

.btn-room-join {
    background-color: rgb(52, 152, 219);
    border-color: rgb(41, 128, 185);
    border-width: 2px;
    border-bottom-width: 4px;
    border-bottom-color: rgb(30, 90, 140);
    border-radius: 6px;
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    padding: 8px 16px;
    transition-duration: 0.1s;
}

.btn-room-join:hover {
    background-color: rgb(41, 128, 185);
}
.btn-room-join:active {
    border-bottom-width: 2px;
    margin-top: 2px;
}

/* --------------------------------------------------------------------------
   SOCCER ARCADE BUTONLAR (SPORTS SYSTEM)
   -------------------------------------------------------------------------- */
.btn-soccer {
    border-radius: 6px; /* Keskin, sportif hatlar */
    border-width: 3px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    padding: 12px 24px;
    align-items: center;
    justify-content: center;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-bounce;
    transition-property: scale, background-color, border-bottom-width, margin-top;
    cursor: link;
    letter-spacing: 1px;
}

.btn-soccer:hover {
    scale: 1.05;
}

.btn-soccer:active {
    scale: 0.95;
    border-bottom-width: 3px;
    margin-top: 5px;
    transition-duration: 0.05s;
}

/* Ana BÃ¼yÃ¼k Buton (YENÄ° MAÃ‡ KUR) */
.btn-soccer-primary {
    width: 100%;
    height: 80px;
    background-color: rgb(241, 196, 15); /* Hakem sarÄ±sÄ± / AltÄ±n kupa */
    border-color: rgb(243, 156, 18);
    border-bottom-width: 8px;
    border-bottom-color: rgb(211, 84, 0);
    color: rgb(44, 62, 80); /* Koyu lacivert yazÄ± */
    font-size: 28px;
    margin-top: 10px;
    margin-bottom: 20px;
}

.btn-soccer-primary:hover { background-color: rgb(243, 156, 18); }

.btn-soccer-green {
    background-color: rgb(46, 204, 113); /* Saha yeÅŸili */
    border-color: rgb(39, 174, 96);
    border-bottom-width: 6px;
    border-bottom-color: rgb(20, 143, 71);
}
.btn-soccer-green:hover { background-color: rgb(39, 174, 96); }

.btn-soccer-red {
    background-color: rgb(231, 76, 60); /* KÄ±rmÄ±zÄ± kart */
    border-color: rgb(192, 57, 43);
    border-bottom-width: 6px;
    border-bottom-color: rgb(150, 40, 27);
}
.btn-soccer-red:hover { background-color: rgb(192, 57, 43); }

.btn-soccer-purple {
    background-color: rgb(155, 89, 182); /* Turnuva moru */
    border-color: rgb(142, 68, 173);
    border-bottom-width: 6px;
    border-bottom-color: rgb(110, 44, 140);
}
.btn-soccer-purple:hover { background-color: rgb(142, 68, 173); }

.footer-bar {
    flex-direction: row;
    width: 85%;
    justify-content: flex-start;
}

.footer-left-buttons {
    flex-direction: row;
    align-items: center;
}

.footer-left-buttons .btn-soccer {
    margin-right: 16px;
}

/* YeÅŸil Buton (GiriÅŸ / BaÅŸlat) */
.btn-cartoon-green {
    background-color: rgb(46, 204, 113);
    border-color: rgb(85, 235, 145);
    border-bottom-width: 6px;
    border-bottom-color: rgb(26, 125, 68);
}

.btn-cartoon-green:hover {
    background-color: rgb(60, 220, 125);
}

.btn-cartoon-green:active {
    border-bottom-width: 2px;
}

/* KÄ±rmÄ±zÄ± Buton (Ã‡Ä±kÄ±ÅŸ / AyrÄ±l) */
.btn-cartoon-red {
    background-color: rgb(231, 76, 60);
    border-color: rgb(255, 120, 110);
    border-bottom-width: 5px;
    border-bottom-color: rgb(150, 40, 30);
}

.btn-cartoon-red:hover {
    background-color: rgb(245, 95, 80);
}

.btn-cartoon-red:active {
    border-bottom-width: 2px;
}

/* Mavi Buton */
.btn-cartoon-blue {
    background-color: rgb(9, 132, 227);
    border-color: rgb(85, 180, 255);
    border-bottom-width: 5px;
    border-bottom-color: rgb(5, 75, 135);
}

.btn-cartoon-blue:hover {
    background-color: rgb(25, 150, 245);
}

.btn-cartoon-blue:active {
    border-bottom-width: 2px;
}

/* Mor Buton */
.btn-cartoon-purple {
    background-color: rgb(108, 92, 231);
    border-color: rgb(160, 148, 255);
    border-bottom-width: 5px;
    border-bottom-color: rgb(65, 50, 155);
}

/* Cyan Buton */
.btn-cartoon-cyan {
    background-color: rgb(0, 184, 148);
    border-color: rgb(85, 235, 205);
    border-bottom-width: 4px;
    border-bottom-color: rgb(0, 110, 90);
}

.btn-small-enter {
    height: 38px;
    padding: 0 16px;
}

.btn-copy-small {
    padding: 4px 12px;
    font-size: 11px;
}

.btn-invite-small {
    padding: 6px 12px;
    font-size: 12px;
    margin-top: 8px;
}

.btn-chat-small {
    height: 38px;
    padding: 0 16px;
}

.btn-large-start {
    font-size: 18px;
    height: 52px;
    padding: 0 32px;
}

/* --------------------------------------------------------------------------
   LOBÄ° ODASI DÃœZENÄ° (VIEW-LOBBY)
   -------------------------------------------------------------------------- */
.main-section {
    flex-grow: 1;
    flex-direction: row;
    margin-bottom: 16px;
}

.roster-panel {
    width: 60%;
    margin-right: 18px;
}

.side-panel {
    flex-grow: 1;
    width: 40%;
}

.slots-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

/* Oyuncu KartÄ± (Cartoon) */
.player-card {
    width: 48%;
    height: 180px;
    border-radius: 18px;
    padding: 14px;
    margin-bottom: 16px;
    align-items: center;
    justify-content: center;
    border-width: 3px;
    position: relative;
}

.active-card {
    background-color: rgb(42, 32, 75);
    border-color: rgb(255, 93, 162); /* Bubblegum Pink / Neon Neon */
    border-bottom-width: 6px;
    border-bottom-color: rgb(20, 14, 40);
}

.active-ready-card {
    background-color: rgb(30, 70, 46) !important; /* Koyu Yeşil Zemin */
    border-color: rgb(46, 204, 113) !important; /* Neon Yeşil (Mint) */
    border-bottom-width: 6px !important;
    border-bottom-color: rgb(15, 40, 25) !important;
}

.empty-card {
    background-color: rgb(28, 20, 50);
    border-color: rgb(55, 40, 95);
    border-bottom-width: 5px;
    border-bottom-color: rgb(15, 10, 30);
    border-style: dashed;
}

.card-crown-tag {
    position: absolute;
    top: 8px;
    left: 8px;
    background-color: rgb(255, 195, 18);
    border-radius: 8px;
    padding: 2px 8px;
}

.crown-text {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(30, 30, 30);
}

.card-avatar {
    width: 58px;
    height: 58px;
    border-radius: 29px;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    border-width: 3px;
}

.avatar-p1 {
    background-color: rgb(255, 107, 0);
    border-color: rgb(255, 204, 0);
}

.avatar-p2 {
    background-color: rgb(9, 132, 227);
    border-color: rgb(100, 210, 255);
}

.avatar-p3 {
    background-color: rgb(155, 89, 182); /* Purple */
    border-color: rgb(210, 150, 255);
}

.avatar-p4 {
    background-color: rgb(231, 76, 60); /* Red */
    border-color: rgb(255, 120, 120);
}

.avatar-tag {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.card-player-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 2px;
}

.card-player-rank {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 215, 64);
    margin-bottom: 6px;
}

.ready-pill {
    background-color: rgb(46, 204, 113);
    border-radius: 8px;
    padding: 3px 12px;
}

.ready-text {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.empty-avatar-circle {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: rgb(38, 28, 68);
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
}

.empty-plus {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(120, 100, 170);
}

.empty-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(140, 120, 190);
}

/* Sohbet Paneli */
.chat-panel-box {
    flex-grow: 1;
    justify-content: space-between;
}

.chat-scroll {
    flex-grow: 1;
    height: 220px;
    background-color: rgb(22, 16, 40);
    border-radius: 12px;
    padding: 10px;
    margin-bottom: 10px;
}

.chat-entry {
    flex-direction: row;
    margin-bottom: 6px;
    white-space: normal;
}

.chat-input-row {
    flex-direction: row;
    align-items: center;
}

.chat-input {
    flex-grow: 1;
    height: 40px;
    background-color: rgb(38, 28, 68);
    border-width: 2px;
    border-color: rgb(90, 70, 150);
    border-radius: 12px;
    margin-right: 8px;
}

.chat-input .unity-text-field__input {
    color: rgb(0, 0, 0);
    font-size: 14px;
    -unity-font-style: bold;
    padding: 6px 12px;
    background-color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
}

.chat-input:focus {
    border-color: rgb(46, 204, 113);
}

.sender-p1 {
    -unity-font-style: bold;
    color: rgb(255, 160, 60);
    margin-right: 6px;
}

.sender-p2 {
    -unity-font-style: bold;
    color: rgb(100, 210, 255);
    margin-right: 6px;
}

.sender-system {
    -unity-font-style: bold;
    color: rgb(255, 215, 64);
    margin-right: 6px;
}

.msg-text-system {
    color: rgb(200, 190, 230);
    font-size: 12px;
    white-space: normal;
}

/* --------------------------------------------------------------------------
   FOOTER BAR (ALT AKSÄ°YON ALANI)
   -------------------------------------------------------------------------- */
.footer-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.footer-left-buttons {
    flex-direction: row;
}

.footer-right-buttons {
    flex-direction: row;
}

.local-player-card {
    background-color: rgb(55, 35, 15);
    border-color: rgb(255, 204, 0);
    border-bottom-width: 6px;
    border-bottom-color: rgb(150, 90, 0);
}

/* TAKIM SISTEMI CSS (2V2) */
.teams-wrapper {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.team-column {
    width: 48%;
    flex-direction: column;
}

.team-badge-red {
    background-color: rgb(220, 50, 50);
    border-color: rgb(150, 20, 20);
    border-radius: 8px;
    padding: 6px;
    margin-bottom: 10px;
    align-items: center;
}

.team-badge-blue {
    background-color: rgb(50, 100, 220);
    border-color: rgb(20, 50, 150);
    border-radius: 8px;
    padding: 6px;
    margin-bottom: 10px;
    align-items: center;
}

.team-red-card {
    background-color: rgb(60, 20, 20);
    border-color: rgb(255, 60, 60);
}

.team-blue-card {
    background-color: rgb(20, 30, 60);
    border-color: rgb(60, 120, 255);
}

/* ==========================================================================
   MODERN FULLSCREEN SETTINGS MENU (REFERANS TASARIM)
   ========================================================================== */

.settings-fullscreen-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85); /* Koyu Arka Plan */
    padding: 20px 50px;
}

.settings-top-bar {
    flex-direction: row;
    height: 80px;
    align-items: flex-end;
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    padding-bottom: 0px;
    margin-bottom: 20px;
}

.settings-top-left {
    width: 250px;
    justify-content: flex-end;
    margin-bottom: 10px;
}

.settings-main-title {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 32px;
    letter-spacing: 2px;
    margin-bottom: 5px;
}

.settings-btn-back {
    background-color: rgb(190, 40, 40);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 14px;
    padding: 6px 30px;
    border-width: 0;
    align-self: flex-start;
    cursor: link;
}

.settings-btn-back:hover {
    background-color: rgb(220, 60, 60);
}

.settings-tabs-container {
    flex-direction: row;
    flex-grow: 1;
    justify-content: center;
    align-items: flex-end;
}

.settings-tab {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 16px;
    padding: 10px 40px;
    background-color: transparent;
    letter-spacing: 1px;
    margin-right: 10px;
}

.settings-tab.active-tab {
    color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 255);
}

.settings-content-wrapper {
    flex-grow: 1;
    padding: 0 10%;
}

.settings-list-scroll {
    flex-grow: 1;
}

.settings-category-header {
    margin-bottom: 10px;
}

.settings-category-title-modern {
    color: rgba(255, 255, 255, 0.4);
    -unity-font-style: bold;
    font-size: 16px;
    letter-spacing: 2px;
}

.settings-row-strip {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 15px 30px;
    min-height: 50px;
}

.row-dark {
    background-color: rgba(0, 0, 0, 0.6);
}

.row-light {
    background-color: rgba(0, 0, 0, 0.3);
}

.settings-row-label {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 18px;
    letter-spacing: 1px;
}

/* KONTROLLER */
.modern-slider, .modern-dropdown, .modern-toggle {
    width: 350px;
}

/* Slider Özelleştirme */
.modern-slider .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 0;
    height: 8px;
    border-radius: 4px;
}

.modern-slider .unity-base-slider__dragger {
    background-color: rgb(255, 240, 180);
    border-width: 0;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    margin-top: -6px;
}

/* Dropdown Özelleştirme */
.modern-dropdown .unity-base-popup-field__input {
    background-color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 0;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    font-size: 16px;
    padding: 8px 12px;
}

.modern-dropdown .unity-base-popup-field__text {
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

/* Toggle Özelleştirme */
.modern-toggle .unity-toggle__input {
    justify-content: flex-end;
}

.modern-toggle .unity-toggle__checkmark {
    background-color: rgb(255, 255, 255);
    border-width: 0;
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: rgb(0, 0, 0);
}
/* =======================================
   LOBBY HEADER STYLES (Eksik Olanlar)
   ======================================= */
.header-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    background-color: rgba(15, 20, 30, 0.9);
    border-bottom-width: 2px;
    border-bottom-color: rgba(46, 204, 113, 0.5);
    margin-bottom: 15px;
}

.header-left, .header-right {
    flex-direction: row;
    align-items: center;
}

.header-center {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.lobby-logo {
    color: #f1c40f;
    font-size: 16px;
    -unity-font-style: bold;
    margin-right: 15px;
}

.lobby-badge {
    background-color: rgba(241, 196, 15, 0.2);
    color: #f1c40f;
    padding: 4px 10px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #f1c40f;
    font-size: 12px;
    -unity-font-style: bold;
}

.room-code-pill {
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 20px;
    padding: 5px 15px;
    border-width: 1px;
    border-color: #2ecc71;
    margin: 0 20px;
}

.room-code-label {
    color: #bdc3c7;
    font-size: 12px;
    margin-right: 5px;
}

.room-code-val {
    color: #2ecc71;
    font-size: 16px;
    -unity-font-style: bold;
    margin-right: 15px;
}


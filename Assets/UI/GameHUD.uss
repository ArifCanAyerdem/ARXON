.hud-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    picking-mode: ignore; 
}

.overlay-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(5, 7, 12, 0.85); /* Derin siyah/lacivert ton */
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.overlay-hidden { opacity: 0; }

/* GERİ SAYIM & DURUM YAZILARI */
.countdown-text {
    font-size: 100px;
    -unity-font-style: italic;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    text-shadow: 0px 0px 10px rgba(0, 255, 255, 0.8);
    scale: 1;
    transition-property: scale, opacity, color;
    transition-duration: 0.3s;
}

.countdown-animate {
    scale: 1.2;
    opacity: 0;
}

.status-label {
    font-size: 28px;
    -unity-font-style: italic;
    color: rgb(200, 220, 255);
    margin-bottom: 10px;
    letter-spacing: 5px;
    text-shadow: 0px 0px 10px rgba(0, 150, 255, 0.6);
}

/* ROCKET LEAGUE STİLİ BOOST METER */
.boost-container {
    position: absolute;
    bottom: 30px;
    right: 30px;
    width: 140px;
    height: 140px;
    align-items: center;
    justify-content: center;
}

.boost-gauge {
    position: absolute;
    width: 100%;
    height: 100%;
}

.boost-text {
    font-size: 45px;
    -unity-font-style: italic;
    color: rgb(0, 255, 255);
    text-shadow: 0px 0px 10px rgba(0, 255, 255, 0.8);
    -unity-font-weight: bold;
    margin-top: -5px;
}

.boost-label {
    position: absolute;
    bottom: 25px;
    font-size: 14px;
    -unity-font-style: italic;
    color: rgb(200, 200, 200);
    letter-spacing: 2px;
    opacity: 0.8;
}

/* HOLOGRAFİK ZAMANLAYICI */
.timer-container {
    position: absolute;
    top: 20px;
    width: 100%;
    align-items: center;
}

.match-timer-text {
    font-size: 32px;
    -unity-font-style: normal;
    color: rgb(255, 255, 255); 
    text-shadow: 0px 0px 8px rgba(0, 255, 255, 0.8);
    letter-spacing: 2px;
}

/* ESPORTS SKOR PANOLARI */
.score-panel-red {
    position: absolute;
    top: 20px;
    right: 40px;
    background-color: rgba(10, 5, 5, 0.9);
    border-left-width: 4px;
    border-left-color: rgb(255, 0, 80);
    padding: 5px 20px;
    border-radius: 2px;
}

.score-text-red {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 0px 0px 10px rgba(255, 0, 80, 0.8);
}

.score-panel-blue {
    position: absolute;
    top: 20px;
    left: 40px;
    background-color: rgba(5, 5, 10, 0.9);
    border-right-width: 4px;
    border-right-color: rgb(0, 200, 255);
    padding: 5px 20px;
    border-radius: 2px;
}

.score-text-blue {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 0px 0px 10px rgba(0, 200, 255, 0.8);
}

/* MAÇ SONU TABLOSU */
.leaderboard-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.95);
    align-items: center;
    justify-content: center;
}

.leaderboard-title {
    font-size: 60px;
    -unity-font-style: italic;
    color: rgb(255, 255, 255);
    margin-bottom: 30px;
    text-shadow: 0px 0px 15px rgba(255, 215, 0, 0.8);
}

.leaderboard-text {
    font-size: 28px;
    color: rgb(220, 220, 220);
    letter-spacing: 2px;
}

/* TAB SKOR TABLOSU (PRO REDESIGN) */
.tab-scoreboard-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(5, 7, 12, 0.9); /* Arka planı koyulaştır */
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(5px);
}

.tab-scoreboard-title {
    font-size: 50px;
    -unity-font-style: italic;
    color: rgb(255, 255, 255);
    margin-bottom: 40px;
    letter-spacing: 8px;
    text-shadow: 0px 0px 15px rgba(255, 255, 255, 0.5);
}

.tab-rows-container {
    flex-direction: column;
    width: 50%;
    height: 70%;
    justify-content: flex-start;
}

.tab-team-row {
    width: 100%;
    height: 46%;
    background-color: rgba(15, 18, 25, 0.9);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 20px;
    margin-bottom: 20px;
}

.blue-row {
    border-top-width: 4px;
    border-top-color: rgb(0, 200, 255);
}

.red-row {
    border-top-width: 4px;
    border-top-color: rgb(255, 0, 80);
}

.tab-team-title {
    font-size: 28px;
    -unity-font-style: normal;
    text-align: left;
    margin-bottom: 20px;
    letter-spacing: 3px;
}

.blue-title { color: rgb(0, 200, 255); }
.red-title { color: rgb(255, 0, 80); }

.tab-team-list {
    flex-grow: 1;
}

.player-stat-row {
    flex-direction: row;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0.03);
    padding: 12px 20px;
    margin-bottom: 8px;
    border-radius: 2px;
    border-left-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.2);
}

.player-stat-name {
    font-size: 22px;
    color: rgb(230, 230, 230);
}

.player-stat-score {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 0px 0px 10px rgba(255, 255, 255, 0.5);
}

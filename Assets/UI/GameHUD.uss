.hud-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    picking-mode: ignore; 
}

.overlay-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(5, 7, 12, 0.85); /* Derin siyah/lacivert ton */
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.overlay-hidden { opacity: 0; }

/* GERİ SAYIM & DURUM YAZILARI */
.countdown-text {
    font-size: 100px;
    -unity-font-style: italic;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    text-shadow: 0px 0px 10px rgba(0, 255, 255, 0.8);
    scale: 1;
    transition-property: scale, opacity, color;
    transition-duration: 0.3s;
}

.countdown-animate {
    scale: 1.2;
    opacity: 0;
}

.status-label {
    font-size: 28px;
    -unity-font-style: italic;
    color: rgb(200, 220, 255);
    margin-bottom: 10px;
    letter-spacing: 5px;
    text-shadow: 0px 0px 10px rgba(0, 150, 255, 0.6);
}

/* KLASİK YATAY GHOST BAR (STAMINA) */
.boost-container {
    position: absolute;
    bottom: 30px;
    right: 40px;
    width: 300px;
    height: 35px;
    align-items: flex-end;
    justify-content: center;
}

.boost-gauge {
    position: absolute;
    width: 100%;
    height: 100%;
}

.boost-label {
    position: absolute;
    top: -25px; /* Barın hemen üstünde yazsın */
    right: 0px;
    font-size: 16px;
    -unity-font-style: italic;
    -unity-font-weight: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 2px;
    text-shadow: 0px 0px 5px rgba(0, 255, 255, 0.8);
}

/* HOLOGRAFİK ZAMANLAYICI */
.timer-container {
    position: absolute;
    top: 20px;
    width: 100%;
    align-items: center;
}

.match-timer-text {
    font-size: 32px;
    -unity-font-style: normal;
    color: rgb(255, 255, 255); 
    text-shadow: 0px 0px 8px rgba(0, 255, 255, 0.8);
    letter-spacing: 2px;
}

/* ESPORTS SKOR PANOLARI */
.score-panel-red {
    position: absolute;
    top: 20px;
    right: 40px;
    background-color: rgba(10, 5, 5, 0.9);
    border-left-width: 4px;
    border-left-color: rgb(255, 0, 80);
    padding: 5px 20px;
    border-radius: 2px;
}

.score-text-red {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 0px 0px 10px rgba(255, 0, 80, 0.8);
}

.score-panel-blue {
    position: absolute;
    top: 20px;
    left: 40px;
    background-color: rgba(5, 5, 10, 0.9);
    border-right-width: 4px;
    border-right-color: rgb(0, 200, 255);
    padding: 5px 20px;
    border-radius: 2px;
}

.score-text-blue {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 0px 0px 10px rgba(0, 200, 255, 0.8);
}

/* MAÇ SONU TABLOSU */
.leaderboard-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.95);
    align-items: center;
    justify-content: center;
}

.leaderboard-title {
    font-size: 60px;
    -unity-font-style: italic;
    color: rgb(255, 255, 255);
    margin-bottom: 30px;
    text-shadow: 0px 0px 15px rgba(255, 215, 0, 0.8);
}

.leaderboard-text {
    font-size: 28px;
    color: rgb(220, 220, 220);
    letter-spacing: 2px;
}

/* TAB SKOR TABLOSU (PRO REDESIGN) */
.tab-scoreboard-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(5, 7, 12, 0.9); /* Arka planı koyulaştır */
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(5px);
}

.tab-scoreboard-box {
    width: 80%;
    height: 70%;
    background-color: rgba(20, 25, 35, 0.85); /* Koyu lacivert/gri arkaplan */
    border-radius: 8px;
    padding: 20px;
    display: flex;
    flex-direction: column;
}

.tab-header-row {
    flex-direction: row;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    margin-bottom: 10px;
}

.tab-col-name {
    width: 30%; /* İsim ve avatar için geniş alan */
}

.tab-col-stat {
    width: 11.6%; /* Kalan %70'i 6 sütuna böl (Goal, Assist, Pass, Interception, Save, Score) */
    -unity-text-align: middle-center;
    color: rgb(200, 200, 200);
    font-size: 14px;
}

.tab-team-section {
    flex-grow: 1;
    margin-bottom: 15px;
    background-color: rgba(0, 0, 0, 0.4);
}

.tab-team-title-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 15px;
}

.home-bg {
    background-color: rgba(0, 150, 136, 0.8); /* Teal / Cyan Mavi */
}

.away-bg {
    background-color: rgba(103, 58, 183, 0.8); /* Purple / Mor Kırmızı */
}

.team-title-text {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 10px;
    letter-spacing: 2px;
}

.tab-player-list {
    flex-grow: 1;
}

.tab-total-row {
    flex-direction: row;
    justify-content: space-between;
    color: rgb(230, 230, 230);
}

.player-stat-score {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 0px 0px 10px rgba(255, 255, 255, 0.5);
}

/* YENİ EKLENEN EKSİK DÜZEN (FLEX ROW) SINIFLARI */
.player-row {
    flex-direction: row;
    align-items: center;
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.player-info-container {
    flex-direction: row;
    align-items: center;
    width: 30%;
}

.player-name {
    color: white;
    font-size: 14px;
    margin-left: 10px;
}

.player-stat {
    width: 11.6%;
    -unity-text-align: middle-center;
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
}
